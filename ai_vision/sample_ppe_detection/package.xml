<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sample_ppe_detection</name>
  <version>1.0.0</version>
  <description>
    PPE (Personal Protective Equipment) detection sample using QNN NPU
    inference via qrb_ros_nn_inference. Bridges /image_raw
    (sensor_msgs/Image) to qrb_inference_input_tensor /
    qrb_inference_output_tensor (qrb_ros_tensor_list_msgs/TensorList),
    and publishes annotated detection results.
  </description>
  <maintainer email="hangshen@qti.qualcomm.com">Hang Shen</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>qrb_ros_tensor_list_msgs</exec_depend>
  <exec_depend>qrb_ros_nn_inference</exec_depend>
  <exec_depend>image_publisher</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>qrb_ros_camera</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
